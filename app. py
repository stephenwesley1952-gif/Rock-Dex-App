
import streamlit as st

st.set_page_config(page_title="RockDex", page_icon="🪨", layout="wide")

st.title("🪨 RockDex: Specimen Catalog & ID")
st.write("Your personal field guide and collection manager for Southwest Missouri minerals and beyond.")

# Create the three-tab structure
tab1, tab2, tab3 = st.tabs(["🔍 Identification", "🧪 Physical Testing Wizard", "📋 Specimen Catalog"])

with tab1:
    st.header("Specimen Identification")
    st.write("Quickly identify chert, druzy quartz, calcite, galena, and more.")
    
    # Simple search / filter inputs
    search_query = st.text_input("Search specimen characteristics (e.g., hardness, color, luster):")
    if search_query:
        st.info(f"Searching database for: {search_query}...")

with tab2:
    st.header("Physical Testing Wizard")
    st.write("Step-by-step guidance for streak, hardness, and acid testing.")
    
    hardness_test = st.selectbox("Select Mohs Hardness Test Result:", ["Select...", "Scratched by fingernail (< 2.5)", "Scratched by copper penny (3.5)", "Scratched by glass (5.5)", "Scratches glass (> 5.5)"])
    if hardness_test != "Select...":
        st.success(f"Noted result: {hardness_test}. This helps narrow down quartz, calcite, and chert.")

with tab3:
    st.header("Specimen Catalog")
    st.write("Log and view your collected specimens.")
    
    with st.form("catalog_form"):
        specimen_name = st.text_input("Specimen Name / Type")
        location_found = st.text_input("Location Found (e.g., local creek bed)")
        notes = st.text_area("Notes & Observations")
        submitted = st.form_submit_button("Save Specimen")
        
        if submitted:
            st.success(f"Saved {specimen_name} to your catalog!")

st.sidebar.markdown("---")
st.sidebar.write("**RockDex v1.1** — Field & Lab Assistant")
